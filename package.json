{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "tailwindcss -i resources/css/index.css -o resources/dist/page-builder-plugin.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "tailwindcss -i resources/css/index.css -o resources/dist/page-builder-plugin.css --minify",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/page-builder-plugin.css -o resources/dist/page-builder-plugin.css -v 4.x",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.1.1",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "esbuild": "^0.28.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.2.1"
    }
}
